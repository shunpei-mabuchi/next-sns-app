# このファイルを backend/.env にコピーし、パスワードを自分の値に変更する。
# backend/.env はGitにコミットしない。

MYSQL_DATABASE=pibit_dev
MYSQL_SHADOW_DATABASE=pibit_shadow
MYSQL_USER=pibit_user
MYSQL_PASSWORD=change_me_user_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Prisma用（次の工程で使用）。ユーザー名・パスワードはMYSQL_USER / MYSQL_PASSWORDと一致させる。
# パスワードに記号を含める場合はURLエンコードが必要。
# rootアカウントはアプリ接続に使用しない。
DATABASE_URL="mysql://pibit_user:change_me_user_password@127.0.0.1:3307/pibit_dev"
SHADOW_DATABASE_URL="mysql://pibit_user:change_me_user_password@127.0.0.1:3307/pibit_shadow"
